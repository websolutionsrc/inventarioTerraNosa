# Copia este archivo como "inventarioTerrNosa/.env" (junto a manage.py) y rellénalo.
# Sin .env el backend arranca en modo local: SQLite y DEBUG activado.

# --- Hosting ---
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
# DJANGO_ALLOWED_HOSTS=tuusuario.pythonanywhere.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tuusuario.pythonanywhere.com

# --- Base de datos MySQL ---
# DB_ENGINE=mysql
# DB_NAME=inventario_db
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306
